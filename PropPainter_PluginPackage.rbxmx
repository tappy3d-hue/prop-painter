				<string name="Name">README_&#227;&#130;&#164;&#227;&#131;&#179;&#227;&#130;&#185;&#227;&#131;&#136;&#227;&#131;&#188;&#227;&#131;&#171;&#230;&#150;&#185;&#230;&#179;&#149;</string>
